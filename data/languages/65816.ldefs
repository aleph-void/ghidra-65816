  <!-- The 65802: the 65816 instruction set on a 6502-compatible 40-pin package with a 16-bit
       address bus. Uses the 65816 processor and compiler specs. -->
  <language processor="65802"
            endian="little"
            size="16"
            variant="default"
            version="1.0"
            slafile="65802.sla"
            processorspec="65816.pspec"
            id="65802:LE:16:default">
    <description>WDC/GTE 65802 (65816 core, 16-bit address bus)</description>
    <compiler name="default" spec="65816.cspec" id="default"/>
  </language>

</language_definitions>
